{
  "version": 1,
  "project": "Мед и Нефть",
  "docs": {
    "gdd.vision": {
      "path": "docs/gdd/01_vision.md",
      "title": "Цель и аудитория",
      "summary": "зачем проект, для кого, платформы"
    },
    "gdd.features": {
      "path": "docs/gdd/02_features.md",
      "title": "Функциональность",
      "summary": "функции и приоритеты"
    },
    "gdd.architecture": {
      "path": "docs/gdd/03_architecture.md",
      "title": "Архитектура и модули",
      "summary": "модули, зоны файлов, данные"
    },
    "gdd.ui": {
      "path": "docs/gdd/04_ui.md",
      "title": "Интерфейс",
      "summary": "экраны, адаптивность, доступность"
    },
    "gdd.quality": {
      "path": "docs/gdd/05_quality.md",
      "title": "Качество и безопасность",
      "summary": "нефункциональные требования, тесты, безопасность"
    },
    "gdd.release": {
      "path": "docs/gdd/06_release.md",
      "title": "Релизы и эксплуатация",
      "summary": "сборка, публикация, откат"
    },
    "gdd.decisions": {
      "path": "docs/gdd/DECISIONS_APPROVED.md",
      "title": "Утверждённые решения",
      "summary": "решения владельца"
    },
    "gdd.economy": {
      "path": "docs/gdd/07_economy.md",
      "title": "Экономические правила",
      "summary": "расчёт, спрос, производство и деньги"
    },
    "gdd.world": {
      "path": "docs/gdd/08_world.md",
      "title": "Мир и география",
      "summary": "города и изометрическая карта"
    }
  },
  "always_docs": [
    "gdd.decisions"
  ],
  "modules": [
    {
      "id": "design",
      "title": "GDD и дорожная карта",
      "paths": [
        "docs/**"
      ],
      "docs": [
        "gdd.vision",
        "gdd.features",
        "gdd.architecture"
      ],
      "contracts": [
        "docs/contracts/design.md"
      ],
      "tests": [],
      "public": [],
      "depends_on": []
    },
    {
      "id": "catalog",
      "title": "Каталоги и рецепты",
      "paths": [
        "server/catalog/**",
        "tests/catalog/**"
      ],
      "docs": [
        "gdd.features",
        "gdd.architecture"
      ],
      "contracts": [
        "docs/contracts/catalog.md"
      ],
      "tests": [
        "tests/catalog/**"
      ],
      "public": [],
      "depends_on": []
    },
    {
      "id": "economy",
      "title": "Целочисленный симулятор производства",
      "paths": [
        "server/economy/**",
        "tests/economy/**"
      ],
      "docs": [
        "gdd.features",
        "gdd.architecture"
      ],
      "contracts": [
        "docs/contracts/economy.md"
      ],
      "tests": [
        "tests/economy/**"
      ],
      "public": [],
      "depends_on": [
        "catalog"
      ]
    },
    {
      "id": "market",
      "title": "Спрос населения и розничный рынок",
      "paths": [
        "server/market/**",
        "tests/market/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/market.md"
      ],
      "tests": [
        "tests/market/**"
      ],
      "public": [],
      "depends_on": [
        "catalog"
      ]
    },
    {
      "id": "companies",
      "title": "Компании, счета и проводки",
      "paths": [
        "server/companies/**",
        "tests/companies/**"
      ],
      "docs": [
        "gdd.features",
        "gdd.architecture"
      ],
      "contracts": [
        "docs/contracts/companies.md"
      ],
      "tests": [
        "tests/companies/**"
      ],
      "public": [],
      "depends_on": []
    },
    {
      "id": "server",
      "title": "Серверные команды и API",
      "paths": [
        "server/api/**",
        "tests/api/**"
      ],
      "docs": [
        "gdd.architecture"
      ],
      "contracts": [
        "docs/contracts/server.md"
      ],
      "tests": [
        "tests/api/**"
      ],
      "public": [],
      "depends_on": [
        "economy",
        "market",
        "companies"
      ]
    },
    {
      "id": "logistics",
      "title": "Поставки и логистика",
      "paths": [
        "server/logistics/**",
        "tests/logistics/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/logistics.md"
      ],
      "tests": [
        "tests/logistics/**"
      ],
      "public": [],
      "depends_on": [
        "catalog",
        "companies"
      ]
    },
    {
      "id": "world",
      "title": "Города и данные мира Башкортостана",
      "paths": [
        "server/world/**",
        "tests/world/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/world.md"
      ],
      "tests": [
        "tests/world/**"
      ],
      "public": [],
      "depends_on": []
    },
    {
      "id": "client_core",
      "title": "Godot Android каркас",
      "paths": [
        "client/project.godot",
        "client/core/**",
        "tests/client_core/**"
      ],
      "docs": [
        "gdd.ui"
      ],
      "contracts": [
        "docs/contracts/client_core.md"
      ],
      "tests": [
        "tests/client_core/**"
      ],
      "public": [],
      "depends_on": []
    },
    {
      "id": "client_map",
      "title": "Изометрическая 3D-карта",
      "paths": [
        "client/map/**",
        "tests/client_map/**"
      ],
      "docs": [
        "gdd.ui"
      ],
      "contracts": [
        "docs/contracts/client_map.md"
      ],
      "tests": [
        "tests/client_map/**"
      ],
      "public": [],
      "depends_on": [
        "client_core",
        "world"
      ]
    },
    {
      "id": "client_ui",
      "title": "Управленческие экраны Android",
      "paths": [
        "client/ui/**",
        "tests/client_ui/**"
      ],
      "docs": [
        "gdd.ui"
      ],
      "contracts": [
        "docs/contracts/client_ui.md"
      ],
      "tests": [
        "tests/client_ui/**"
      ],
      "public": [],
      "depends_on": [
        "client_core",
        "server"
      ]
    },
    {
      "id": "integration",
      "title": "Сквозной экономический цикл",
      "paths": [
        "tests/integration/**",
        "tools/scenarios/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/integration.md"
      ],
      "tests": [
        "tests/integration/**"
      ],
      "public": [],
      "depends_on": [
        "server",
        "logistics",
        "world",
        "client_map",
        "client_ui"
      ]
    },
    {
      "id": "release",
      "title": "Android альфа и проверка производительности",
      "paths": [
        "release/**",
        "tests/release/**",
        "client/export_presets.cfg"
      ],
      "docs": [
        "gdd.release",
        "gdd.quality"
      ],
      "contracts": [
        "docs/contracts/release.md"
      ],
      "tests": [
        "tests/release/**"
      ],
      "public": [],
      "depends_on": [
        "integration"
      ]
    },
    {
      "id": "research",
      "title": "Наука, технологии и оборудование",
      "paths": [
        "server/research/**",
        "tests/research/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/research.md"
      ],
      "tests": [
        "tests/research/**"
      ],
      "public": [],
      "depends_on": [
        "economy",
        "companies"
      ]
    },
    {
      "id": "social",
      "title": "Корпорации и совместные контракты",
      "paths": [
        "server/social/**",
        "tests/social/**"
      ],
      "docs": [
        "gdd.features"
      ],
      "contracts": [
        "docs/contracts/social.md"
      ],
      "tests": [
        "tests/social/**"
      ],
      "public": [],
      "depends_on": [
        "server",
        "companies"
      ]
    }
  ],
  "critical_rules": [
    "Общие файлы GDD, docs/work_plan.json и индекс изменяет только директор.",
    "Выполнено только после зелёного CI и слияния PR.",
    "Никаких изменений чужих VPS-сервисов, деплой только по разрешению владельца."
  ]
}
